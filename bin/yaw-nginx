#!/usr/bin/env python3
"""Aplica la configuracion de nginx del repo gitops recibida por stdin como
tar(.gz). Lo invoca servicio-init.sh con la accion 'nginx'.

Flujo:
  1. Recibe y valida el tar (solo nginx.conf, renovar_certificados.sh y
     conf.d/*.conf; sin rutas absolutas, '..' ni enlaces; tamanos acotados).
  2. Valida server_name (bajo .yaw-iot.com, duplicados http/https como aviso)
     y backends (nombre valido de contenedor).
  3. Verifica que cada backend http://NOMBRE:80 apunte a un contenedor que
     exista. Un nombre casi identico (segmentos permutados o diferencia
     minima) se rechaza con sugerencia: es un typo, no un servicio sin
     desplegar. Un backend sin contenedor y sin parecidos solo avisa.
  4. Genera la lista DOMAINS del renovar_certificados.sh desde los conf.d.
  5. Certificados idempotentes: emite los faltantes, renueva los vencidos y
     no toca los sanos (certbot --keep-until-expiring).
  6. Valida sintaxis real con 'nginx -t' en un contenedor desechable (misma
     imagen del nginx del host, certs y certbot montados).
  7. Aplica de forma atomica: respaldo del estado anterior, copia a
     /opt/nginx, 'nginx -t' real y reload. Si el -t real falla, restaura.
"""
import os, re, sys, syslog, tarfile, shutil, subprocess, difflib

NGINX_DIR    = "/opt/nginx"
NGINX_CONF   = os.path.join(NGINX_DIR, "nginx.conf")
NGINX_CONF_D = os.path.join(NGINX_DIR, "conf.d")
RENOVAR      = os.path.join(NGINX_DIR, "renovar_certificados.sh")
CERTS_HOST   = os.path.join(NGINX_DIR, "certs")
CERTBOT_HOST = "/var/www/certbot"
IMAGEN_NGINX = "nginx:1.27"
STAGING      = "/var/lib/yaw/nginx-staging"
BACKUP       = "/var/lib/yaw/nginx-backup"
MAX_FILE     = 64 * 1024
MAX_TAR      = 2 * 1024**2
EMAIL_CERTBOT = "labotecperupuyu@gmail.com"
IP           = (os.environ.get("SSH_CLIENT") or "local").split(" ")[0]

CONF_OK    = re.compile(r"^conf\.d/[A-Za-z0-9][A-Za-z0-9._-]*\.conf$")
NAME_OK    = re.compile(r"^[a-z0-9][a-z0-9-]{1,48}$")
DOMINIO_OK = re.compile(r"^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*$")


def log(m):
    """Registra en syslog con el tag yaw-nginx."""
    syslog.openlog("yaw-nginx", syslog.LOG_PID)
    syslog.syslog(f"ip={IP} {m}")


def morir(m):
    """Registra el error y termina con estado 1."""
    log(f"RECHAZADO {m}")
    print(f"ERROR: {m}", file=sys.stderr)
    sys.exit(1)


def aviso(m):
    """Aviso no bloqueante por stderr."""
    print(f"  aviso: {m}", file=sys.stderr)


def docker(*a, timeout=120):
    """Ejecuta docker con salida capturada."""
    return subprocess.run(["docker", *a], capture_output=True,
                          text=True, timeout=timeout)


def revisar_conf(nombre, datos, dominios, backends):
    """Valida server_name y backends de un conf; acumula los dominios y los
    nombres de contenedor de cada http://NOMBRE:80."""
    texto = datos.decode("utf-8", errors="replace")
    for m in re.finditer(r"server_name\s+([^;]+);", texto):
        for d in m.group(1).split():
            if d == "_":
                continue
            if not d.endswith(".yaw-iot.com") or \
               not DOMINIO_OK.match(d[:-len(".yaw-iot.com")]):
                morir(f"{nombre}: server_name invalido: {d!r}")
            if d in dominios:
                aviso(f"server_name repetido: {d} "
                      f"(en {dominios[d]} y {nombre})")
                continue
            dominios[d] = nombre
    for m in re.finditer(
            r"(?:set\s+\$backend|proxy_pass)\s+http://"
            r"([A-Za-z0-9][A-Za-z0-9._-]*):80", texto):
        if not NAME_OK.match(m.group(1)):
            morir(f"{nombre}: backend invalido: {m.group(1)!r}")
        backends.add(m.group(1))


def cercano(a, b):
    """True si dos nombres difieren como para ser un typo: mismos segmentos
    en distinto orden, o mismo largo con diferencia minima. No marca pares
    dev/prod (difieren en largo)."""
    if sorted(a.split("-")) == sorted(b.split("-")):
        return True
    if len(a) == len(b):
        return difflib.SequenceMatcher(None, a, b).ratio() >= 0.9
    return False


def validar_backends(backends):
    """Rechaza backends que no existen como contenedor cuando hay un nombre
    casi identico corriendo (typo), y avisa si simplemente no hay contenedor
    (front sin desplegar todavia)."""
    if not backends:
        return
    r = docker("ps", "--format", "{{.Names}}")
    vivos = {n for n in (r.stdout or "").split() if n}
    for b in sorted(backends):
        if b in vivos:
            continue
        parecidos = sorted(n for n in vivos if cercano(b, n))
        if parecidos:
            morir(f"backend {b} no existe como contenedor; "
                  f"quiza quisiste decir: {', '.join(parecidos)}")
        aviso(f"backend {b}: no hay contenedor con ese nombre todavia "
              f"(front sin desplegar o nombre por verificar)")


def recibir_tar():
    """Extrae y valida el tar de stdin en STAGING; devuelve (dominios,
    backends) para validar certificados y contenedores."""
    if os.path.exists(STAGING):
        shutil.rmtree(STAGING)
    os.makedirs(os.path.join(STAGING, "conf.d"))

    total = 0
    vistos = set()
    dominios = {}
    backends = set()
    con_nginx_conf = False

    try:
        with tarfile.open(fileobj=sys.stdin.buffer, mode="r|*") as tar:
            for miembro in tar:
                nombre = miembro.name
                if nombre.startswith("./"):
                    nombre = nombre[2:]
                if miembro.isdir():
                    continue
                if nombre not in ("nginx.conf", "renovar_certificados.sh") \
                   and not CONF_OK.match(nombre):
                    morir(f"archivo no permitido en el tar: {nombre!r}")
                if miembro.issym() or miembro.islnk():
                    morir(f"enlaces no permitidos: {nombre}")
                if not miembro.isfile():
                    morir(f"entrada no regular: {nombre}")
                if miembro.size > MAX_FILE:
                    morir(f"{nombre} excede {MAX_FILE // 1024} KB")
                total += miembro.size
                if total > MAX_TAR:
                    morir("el tar excede 2 MB")
                if nombre in vistos:
                    morir(f"archivo duplicado en el tar: {nombre}")
                vistos.add(nombre)
                if nombre == "nginx.conf":
                    con_nginx_conf = True

                f = tar.extractfile(miembro)
                if f is None:
                    continue
                datos = f.read()
                with open(os.path.join(STAGING, nombre), "wb") as salida:
                    salida.write(datos)
                if nombre.startswith("conf.d/"):
                    revisar_conf(nombre, datos, dominios, backends)
    except tarfile.TarError as ex:
        morir(f"el stdin no es un tar valido: {ex}")

    if not con_nginx_conf:
        morir("falta nginx.conf en el tar")
    return dominios, backends


def validar_sintaxis():
    """Valida la config con 'nginx -t' en un contenedor desechable."""
    r = docker("run", "--rm",
               "-v", f"{STAGING}/nginx.conf:/etc/nginx/nginx.conf:ro",
               "-v", f"{STAGING}/conf.d:/etc/nginx/conf.d:ro",
               "-v", f"{CERTS_HOST}:/etc/letsencrypt:ro",
               "-v", f"{CERTBOT_HOST}:/var/www/certbot:ro",
               IMAGEN_NGINX, "nginx", "-t")
    if r.returncode != 0:
        salida = r.stderr or r.stdout
        faltan = set(re.findall(
            r'cannot load certificate "/etc/letsencrypt/live/([^"]+)/fullchain\.pem"',
            salida))
        hint = ""
        if faltan:
            hint = ("\nCertificados faltantes: " + ", ".join(sorted(faltan)) +
                    "\n  Genera primero (uno por dominio):\n" +
                    "  docker run --rm -v /opt/nginx/certs:/etc/letsencrypt " +
                    "-v /var/www/certbot:/var/www/certbot certbot/certbot:latest " +
                    "certonly --webroot -w /var/www/certbot --non-interactive " +
                    "--agree-tos --no-eff-email --keep-until-expiring " +
                    "--key-type ecdsa --email labotecperupuyu@gmail.com -d <dominio>")
        morir("la config no pasa 'nginx -t':\n" + salida[:1500] + hint)


def generar_renovar(dominios):
    """Rellena el marcador '# @@DOMAINS@@' del renovar_certificados.sh."""
    ruta = os.path.join(STAGING, "renovar_certificados.sh")
    if not os.path.isfile(ruta):
        return
    with open(ruta, encoding="utf-8", errors="replace") as f:
        texto = f.read()
    if "# @@DOMAINS@@" not in texto:
        return
    lineas = "\n".join(f"  {d}" for d in sorted(dominios))
    texto = texto.replace("# @@DOMAINS@@", lineas)
    with open(ruta, "w", encoding="utf-8") as f:
        f.write(texto)


def renovar_certs(dominios):
    """Certificados idempotentes: emite faltantes, renueva vencidos,
    no toca los sanos."""
    if not dominios:
        return
    emitidos = []
    for d in sorted(dominios):
        print(f"  certificado: {d} ...")
        r = docker("run", "--rm",
                   "-v", f"{CERTS_HOST}:/etc/letsencrypt",
                   "-v", f"{CERTBOT_HOST}:/var/www/certbot",
                   "certbot/certbot:latest", "certonly", "--webroot",
                   "-w", "/var/www/certbot",
                   "--non-interactive", "--agree-tos", "--no-eff-email",
                   "--keep-until-expiring", "--key-type", "ecdsa",
                   "--email", EMAIL_CERTBOT, "-d", d,
                   timeout=300)
        if r.returncode != 0:
            morir(f"certbot fallo para {d}:\n" + (r.stderr or r.stdout)[:800])
        salida = r.stdout or r.stderr or ""
        if "Successfully received certificate" in salida:
            emitidos.append(d)
        print(f"    OK {d}")
    if emitidos:
        print(f"  certificados: {len(emitidos)} emitido(s)/renovado(s), "
              f"{len(dominios) - len(emitidos)} al dia")


def respaldar():
    """Guarda una copia del estado actual de /opt/nginx en BACKUP."""
    if os.path.exists(BACKUP):
        shutil.rmtree(BACKUP)
    os.makedirs(os.path.join(BACKUP, "conf.d"))
    if os.path.isfile(NGINX_CONF):
        shutil.copy2(NGINX_CONF, os.path.join(BACKUP, "nginx.conf"))
    if os.path.isfile(RENOVAR):
        shutil.copy2(RENOVAR, os.path.join(BACKUP, "renovar_certificados.sh"))
    for f in os.listdir(NGINX_CONF_D):
        p = os.path.join(NGINX_CONF_D, f)
        if os.path.isfile(p):
            shutil.copy2(p, os.path.join(BACKUP, "conf.d", f))


def restaurar():
    """Restaura el respaldo y recarga nginx."""
    for f in os.listdir(NGINX_CONF_D):
        p = os.path.join(NGINX_CONF_D, f)
        if os.path.isfile(p):
            os.remove(p)
    for f in os.listdir(os.path.join(BACKUP, "conf.d")):
        shutil.copy2(os.path.join(BACKUP, "conf.d", f), NGINX_CONF_D)
    if os.path.isfile(os.path.join(BACKUP, "nginx.conf")):
        shutil.copy2(os.path.join(BACKUP, "nginx.conf"), NGINX_CONF)
    if os.path.isfile(os.path.join(BACKUP, "renovar_certificados.sh")):
        shutil.copy2(os.path.join(BACKUP, "renovar_certificados.sh"), RENOVAR)
        os.chmod(RENOVAR, 0o700)
    docker("exec", "nginx", "nginx", "-s", "reload")


def aplicar():
    """Copia STAGING a /opt/nginx, valida el -t real y recarga; con
    restauracion automatica si el -t real falla."""
    respaldar()

    for f in os.listdir(NGINX_CONF_D):
        p = os.path.join(NGINX_CONF_D, f)
        if os.path.isfile(p):
            os.remove(p)
    for f in os.listdir(os.path.join(STAGING, "conf.d")):
        shutil.copy2(os.path.join(STAGING, "conf.d", f), NGINX_CONF_D)
    shutil.copy2(os.path.join(STAGING, "nginx.conf"), NGINX_CONF)
    if os.path.isfile(os.path.join(STAGING, "renovar_certificados.sh")):
        shutil.copy2(os.path.join(STAGING, "renovar_certificados.sh"), RENOVAR)
        os.chmod(RENOVAR, 0o700)

    r = docker("exec", "nginx", "nginx", "-t")
    if r.returncode != 0:
        print("!! 'nginx -t' real fallo tras aplicar; restaurando respaldo",
              file=sys.stderr)
        restaurar()
        morir("la config aplicada no paso el 'nginx -t' real; "
              "se restauro el estado anterior")


def main():
    """Punto de entrada: recibir, validar backends, certificados, aplicar y
    recargar."""
    os.umask(0o077)
    dominios, backends = recibir_tar()
    validar_backends(backends)
    generar_renovar(dominios)
    renovar_certs(dominios)
    validar_sintaxis()
    aplicar()
    print(f"OK nginx: {len(dominios)} dominio(s) revisados; "
          f"nginx.conf + conf.d aplicados y recargados")
    log(f"OK dominios={len(dominios)} aplicados")


if __name__ == "__main__":
    main()
